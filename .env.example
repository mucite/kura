# Hugging Face API Token for model access
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Digistore24 License API Configuration
# Found in your Digistore24 dashboard → Account → API
DS24_API_KEY=your_digistore24_api_key
DS24_PRODUCT_ID=your_digistore24_product_id
